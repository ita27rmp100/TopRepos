<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./main/head.ejs') %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>TopRepos | <%=country%> </title>
</head>
<body>
    <!-- navbar -->
    <%- include('./main/navbar.ejs') %>
    <!-- Header -->
    <header class="jumbotron jumbotron-fluid text-center bg-primary text-white mb-0">
        <div class="container">
            <h1 class="display-5 font-weight-bold headerTitle">Discover Top GitHub Repositories</h1>
            <p class="lead mt-1 mb-3">Explore the most popular open-source projects by country. Stay inspired and contribute!</p>
            <h3 class="display-5 alert alert-primary" id="country-name"><%=country%></span></h3>
        </div>
    </header>
    <!-- list of top projects -->
    <nav class="container-fluid d-flex flex-column justify-content-center align-items-center mb-5" id="data">
        <!-- project sample : loading while fetching data -->      
        <div class="loading-container d-flex row justify-content-center pt-5" id="loading"> 
            <div class="spinner-border text-primary" role="status" style="width: 4rem; height: 4rem;">
                <span class="sr-only">Loading...</span>
            </div>
            <div class="mt-3 text-secondary text-center">Loading, please wait...</div>
        </div>
    </nav>
    <!-- footer -->
    <%- include('./main/footer.ejs') %>
    <!-- sripts -->
    <%- include('./main/scripts.ejs') %>
    <script src="/javascripts/TopList.js"></script>
</body>
</html>